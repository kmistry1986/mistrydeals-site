{
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/catalogue"
    },
    {
      "source": "/admin/catalogue",
      "destination": "/catalogue"
    },
    {
      "source": "/admin/dealqueue",
      "destination": "/dealqueue"
    },
    {
      "source": "/admin/queue",
      "destination": "/dealqueue"
    },
    {
      "source": "/admin/carousel",
      "destination": "/carousel"
    },
    {
      "source": "/admin/brands",
      "destination": "/brandrules"
    },
    {
      "source": "/admin/scrapes",
      "destination": "/scrapelog"
    },
    {
      "source": "/admin/reddit",
      "destination": "/redditposter"
    },
    {
      "source": "/admin/reddit-poster",
      "destination": "/redditposter"
    },
    {
      "source": "/reddit-poster",
      "destination": "/redditposter"
    },
    {
      "source": "/admin/guides",
      "destination": "/buyingguides"
    },
    {
      "source": "/buying-guides",
      "destination": "/buyingguides"
    },
    {
      "source": "/admin/guidecarousel",
      "destination": "/guidecarousel"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)/(DealCard|DealCardMini|DealRow|ProductImage)\\.dc\\.html",
      "destination": "/$2.dc.html"
    },
    {
      "source": "/catalogue",
      "destination": "/catalogue.html"
    },
    {
      "source": "/dealqueue",
      "destination": "/dealqueue.html"
    },
    {
      "source": "/carousel",
      "destination": "/carousel.html"
    },
    {
      "source": "/brandrules",
      "destination": "/dealqueue.html"
    },
    {
      "source": "/scrapelog",
      "destination": "/dealqueue.html"
    },
    {
      "source": "/redditposter",
      "destination": "/redditposter.html"
    },
    {
      "source": "/buyingguides",
      "destination": "/buyingguides.html"
    },
    {
      "source": "/guidecarousel",
      "destination": "/guidecarousel.html"
    },
    {
      "source": "/d/:slug",
      "destination": "https://qolksrytidvxarrlygyy.supabase.co/functions/v1/deal-redirect?slug=:slug"
    },
    {
      "source": "/deals",
      "destination": "/index.html"
    },
    {
      "source": "/deals/:chip",
      "destination": "/index.html"
    },
    {
      "source": "/categories",
      "destination": "/index.html"
    },
    {
      "source": "/categories/:cat",
      "destination": "/index.html"
    },
    {
      "source": "/guides",
      "destination": "/index.html"
    },
    {
      "source": "/guides/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/prime",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/mobile",
      "destination": "/index.html"
    },
    {
      "source": "/deal",
      "destination": "/index.html"
    },
    {
      "source": "/deal/:id",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    }
  ]
}
