{
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/catalogue"
    },
    {
      "source": "/admin/catalogue",
      "destination": "/catalogue"
    },
    {
      "source": "/admin/dealqueue",
      "destination": "/dealqueue"
    },
    {
      "source": "/admin/queue",
      "destination": "/dealqueue"
    },
    {
      "source": "/admin/carousel",
      "destination": "/carousel"
    },
    {
      "source": "/admin/brands",
      "destination": "/brandrules"
    },
    {
      "source": "/admin/scrapes",
      "destination": "/scrapelog"
    }
  ],
  "rewrites": [
    {
      "source": "/catalogue",
      "destination": "/catalogue.html"
    },
    {
      "source": "/dealqueue",
      "destination": "/dealqueue.html"
    },
    {
      "source": "/carousel",
      "destination": "/carousel.html"
    },
    {
      "source": "/brandrules",
      "destination": "/dealqueue.html"
    },
    {
      "source": "/scrapelog",
      "destination": "/dealqueue.html"
    },
    {
      "source": "/d/:slug",
      "destination": "https://qolksrytidvxarrlygyy.supabase.co/functions/v1/deal-meta?slug=:slug"
    }
  ]
}
