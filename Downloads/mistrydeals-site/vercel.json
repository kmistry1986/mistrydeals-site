{
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/catalogue"
    },
    {
      "source": "/admin/queue",
      "destination": "/admin/dealqueue"
    },
    {
      "source": "/admin/queue/:path*",
      "destination": "/admin/dealqueue"
    }
  ],
  "rewrites": [
    {
      "source": "/admin/catalogue",
      "destination": "/catalogue.html"
    },
    {
      "source": "/admin/dealqueue",
      "destination": "/dealqueue.html"
    },
    {
      "source": "/admin/brands",
      "destination": "/dealqueue.html"
    },
    {
      "source": "/admin/scrapes",
      "destination": "/dealqueue.html"
    },
    {
      "source": "/admin/:name.dc.html",
      "destination": "/:name.dc.html"
    },
    {
      "source": "/d/:slug",
      "destination": "https://qolksrytidvxarrlygyy.supabase.co/functions/v1/deal-meta?slug=:slug"
    }
  ]
}
