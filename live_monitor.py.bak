#!/usr/bin/env python3
"""
live_monitor.py — Server-side live signal engine for trading.mistrydeals.com
Runs during NYSE market hours only. Polls Yahoo Finance, computes bias signals,
writes to Supabase, sends Pushover notifications on signal changes.

Install deps:
  pip install requests supabase python-dotenv exchange-calendars --break-system-packages

Run as service:
  sudo systemctl enable live-monitor
  sudo systemctl start live-monitor

Config file: ~/trading/monitor_config.json
"""

import os, json, time, math, datetime, logging, requests
from pathlib import Path

# ── Logging ──────────────────────────────────────────────────────────────────
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s %(levelname)s %(message)s',
    handlers=[
        logging.FileHandler('/home/kushal_b_mistry/trading/live_monitor.log'),
        logging.StreamHandler()
    ]
)
log = logging.getLogger(__name__)

# ── Config ───────────────────────────────────────────────────────────────────
CONFIG_PATH = Path.home() / 'trading' / 'monitor_config.json'

DEFAULT_CONFIG = {
    "tickers":          ["SPY"],          # SPY always monitored; add more here
    "poll_interval":    10,               # seconds between polls
    "bias_entry":       2,                # buy signal threshold
    "bias_exit":        -1,               # sell signal threshold
    "max_spend":        500,              # max $ per trade alert
    "pushover_token":   "",               # Pushover API token (optional)
    "pushover_user":    "",               # Pushover user key (optional)
    "supabase_url":     "",               # from env or config
    "supabase_key":     ""                # from env or config
}

def load_config():
    cfg = DEFAULT_CONFIG.copy()
    if CONFIG_PATH.exists():
        try:
            cfg.update(json.loads(CONFIG_PATH.read_text()))
        except Exception as e:
            log.warning(f"Config load failed: {e}")
    # Env overrides
    cfg["supabase_url"] = os.getenv("SUPABASE_URL", cfg["supabase_url"])
    cfg["supabase_key"] = os.getenv("SUPABASE_KEY", cfg["supabase_key"])
    cfg["pushover_token"] = os.getenv("PUSHOVER_TOKEN", cfg["pushover_token"])
    cfg["pushover_user"]  = os.getenv("PUSHOVER_USER",  cfg["pushover_user"])
    return cfg

# ── Market hours ─────────────────────────────────────────────────────────────
def is_market_open():
    """Return True if NYSE is currently open (9:30-16:00 ET, weekdays, non-holiday)."""
    import datetime, zoneinfo
    et = zoneinfo.ZoneInfo("America/New_York")
    now_et = datetime.datetime.now(et)
    if now_et.weekday() >= 5:  # Saturday=5, Sunday=6
        return False
    # Basic US holidays (expand as needed)
    holidays = {
        datetime.date(2026, 1, 1), datetime.date(2026, 1, 19),
        datetime.date(2026, 2, 16), datetime.date(2026, 4, 3),
        datetime.date(2026, 5, 25), datetime.date(2026, 7, 3),
        datetime.date(2026, 9, 7),  datetime.date(2026, 11, 26),
        datetime.date(2026, 12, 25),
    }
    if now_et.date() in holidays:
        return False
    open_t  = now_et.replace(hour=9,  minute=30, second=0, microsecond=0)
    close_t = now_et.replace(hour=16, minute=0,  second=0, microsecond=0)
    return open_t <= now_et <= close_t

def seconds_until_open():
    """Seconds until next market open."""
    import zoneinfo
    et = zoneinfo.ZoneInfo("America/New_York")
    now_et = datetime.datetime.now(et)
    # Try today first, then advance days
    for d in range(8):
        candidate = now_et + datetime.timedelta(days=d)
        if candidate.weekday() >= 5: continue
        open_t = candidate.replace(hour=9, minute=30, second=0, microsecond=0)
        if open_t > now_et:
            return (open_t - now_et).total_seconds()
    return 3600  # fallback

# ── Yahoo Finance fetch ───────────────────────────────────────────────────────
HEADERS = {"User-Agent": "Mozilla/5.0"}

def fetch_intraday(ticker, interval="5m"):
    """Fetch today's intraday bars from Yahoo Finance."""
    url = f"https://query1.finance.yahoo.com/v8/finance/chart/{ticker}?interval={interval}&range=1d&includePrePost=false"
    try:
        r = requests.get(url, headers=HEADERS, timeout=10)
        data = r.json().get("chart", {}).get("result") or []
        if not data: return []
        result = data[0]
        ts_list = result.get("timestamp", []) or []
        q = result.get("indicators", {}).get("quote", [{}])[0]
        opens  = q.get("open",   []) or []
        highs  = q.get("high",   []) or []
        lows   = q.get("low",    []) or []
        closes = q.get("close",  []) or []
        vols   = q.get("volume", []) or []
        bars = []
        for i, ts in enumerate(ts_list):
            if i >= len(closes) or closes[i] is None: continue
            bars.append({
                "ts": ts,
                "o": round(opens[i]  or closes[i], 2),
                "h": round(highs[i]  or closes[i], 2),
                "l": round(lows[i]   or closes[i], 2),
                "c": round(closes[i], 2),
                "v": int(vols[i] or 0) if i < len(vols) else 0
            })
        return bars
    except Exception as e:
        log.warning(f"fetch_intraday {ticker}: {e}")
        return []

def fetch_prev_day_levels(ticker):
    """Fetch previous day OHLC for S/R levels."""
    try:
        url = f"https://query1.finance.yahoo.com/v8/finance/chart/{ticker}?interval=1d&range=5d"
        r = requests.get(url, headers=HEADERS, timeout=10)
        data = r.json().get("chart", {}).get("result") or []
        if not data: return {}
        result = data[0]
        q = result.get("indicators", {}).get("quote", [{}])[0]
        closes = [c for c in (q.get("close") or []) if c]
        highs  = [h for h in (q.get("high")  or []) if h]
        lows   = [l for l in (q.get("low")   or []) if l]
        if len(closes) < 2: return {}
        # Previous day = second to last
        h, l, c = highs[-2], lows[-2], closes[-2]
        pp = (h + l + c) / 3
        return {
            "prevDayH": round(h, 2),
            "prevDayL": round(l, 2),
            "pivots": {
                "PP": round(pp, 2),
                "R1": round(2*pp - l, 2),
                "R2": round(pp + (h - l), 2),
                "S1": round(2*pp - h, 2),
                "S2": round(pp - (h - l), 2),
            }
        }
    except Exception as e:
        log.warning(f"fetch_prev_day_levels {ticker}: {e}")
        return {}

# ── Signal computation ────────────────────────────────────────────────────────
def compute_rsi(closes, period=14):
    if len(closes) < period + 1: return None
    gains, losses = [], []
    for i in range(1, len(closes)):
        d = closes[i] - closes[i-1]
        gains.append(max(d, 0))
        losses.append(max(-d, 0))
    ag = sum(gains[-period:]) / period
    al = sum(losses[-period:]) / period
    return round(100 - 100 / (1 + ag / al), 1) if al > 0 else 100

def compute_vwap(bars):
    """Cumulative VWAP from first bar."""
    cum_pv = cum_v = 0.0
    vwap = []
    for b in bars:
        typ = (b["h"] + b["l"] + b["c"]) / 3
        v = b["v"] or 1
        cum_pv += typ * v
        cum_v  += v
        vwap.append(cum_pv / cum_v)
    return vwap

def compute_bias(bars, levels):
    """
    Same logic as JS hook and paper-backtest server.
    Returns (bias_int, reasons_list, rsi, vwap_current)
    """
    if len(bars) < 5:
        return 0, [], None, None

    closes = [b["c"] for b in bars]
    price  = closes[-1]
    bias   = 0
    reasons = []

    # RSI
    rsi = compute_rsi(closes)
    if rsi is not None:
        if rsi < 30:   bias += 2; reasons.append(f"RSI oversold({rsi})")
        elif rsi < 40: bias += 1; reasons.append(f"RSI low({rsi})")
        elif rsi > 70: bias -= 2; reasons.append(f"RSI overbought({rsi})")
        elif rsi > 60: bias -= 1; reasons.append(f"RSI high({rsi})")

    # VWAP
    vwap_series = compute_vwap(bars)
    vwap_cur = vwap_series[-1] if vwap_series else None
    if vwap_cur:
        dist = (price - vwap_cur) / vwap_cur
        if dist > 0.001:   bias -= 1; reasons.append(f"Above VWAP(${vwap_cur:.2f})")
        elif dist < -0.001: bias += 1; reasons.append(f"Below VWAP(${vwap_cur:.2f})")

    # S/R proximity
    if levels:
        piv = levels.get("pivots", {})
        all_lvls = [
            ("PP",  piv.get("PP",  0)),
            ("R1",  piv.get("R1",  0)),
            ("R2",  piv.get("R2",  0)),
            ("S1",  piv.get("S1",  0)),
            ("S2",  piv.get("S2",  0)),
            ("PDH", levels.get("prevDayH", 0)),
            ("PDL", levels.get("prevDayL", 0)),
        ]
        above = [(l, p) for l, p in all_lvls if p and p > price]
        below = [(l, p) for l, p in all_lvls if p and p < price]
        if above:
            nr = min(above, key=lambda x: x[1])
            if (nr[1] - price) / price < 0.003:
                bias -= 2; reasons.append(f"Near {nr[0]} resistance(${nr[1]:.2f})")
        if below:
            ns = max(below, key=lambda x: x[1])
            if (price - ns[1]) / price < 0.003:
                bias += 2; reasons.append(f"Near {ns[0]} support(${ns[1]:.2f})")

    # Volume spike
    if len(bars) >= 10:
        recent_vols = [b["v"] for b in bars[-10:]]
        avg_v = sum(recent_vols[:-1]) / max(1, len(recent_vols) - 1)
        last_v = recent_vols[-1]
        if avg_v > 0:
            vr = last_v / avg_v
            if vr >= 2.0:
                vdir = "bullish" if bars[-1]["c"] >= bars[-1]["o"] else "bearish"
                bias += (1 if vdir == "bullish" else -1)
                reasons.append(f"Vol spike {vr:.1f}x ({vdir})")

    # Candlestick reversal (simplified)
    c = closes
    n = len(c)
    if n >= 3:
        if c[-1] > c[-2] < c[-3] and (c[-1] - c[-3]) / c[-3] > 0.005:
            bias += 1; reasons.append("Bullish reversal")
        elif c[-1] < c[-2] > c[-3] and (c[-3] - c[-1]) / c[-3] > 0.005:
            bias -= 1; reasons.append("Bearish reversal")

    return max(-3, min(3, bias)), reasons, rsi, vwap_cur

# ── Supabase client ───────────────────────────────────────────────────────────
def get_supabase(cfg):
    url = cfg.get("supabase_url")
    key = cfg.get("supabase_key")
    if not url or not key: return None
    try:
        from supabase import create_client
        return create_client(url, key)
    except Exception as e:
        log.warning(f"Supabase init failed: {e}")
        return None

def save_signal(sb, ticker, bias, price, rsi, vwap, reasons):
    if not sb: return
    try:
        sb.table("live_signals").upsert([{
            "ticker":   ticker,
            "bias":     bias,
            "price":    round(price, 2),
            "rsi":      rsi,
            "vwap":     round(vwap, 2) if vwap else None,
            "reasons":  ", ".join(reasons),
            "updated_at": datetime.datetime.utcnow().isoformat()
        }], on_conflict="ticker").execute()
    except Exception as e:
        log.warning(f"save_signal {ticker}: {e}")

def save_alert(sb, ticker, side, price, bias, reasons, target=None, stop=None):
    if not sb: return
    try:
        sb.table("live_alerts").insert([{
            "ticker":   ticker,
            "side":     side,
            "price":    round(price, 2),
            "bias":     bias,
            "reasons":  ", ".join(reasons),
            "target":   round(target, 2) if target else None,
            "stop":     round(stop, 2)   if stop   else None,
            "created_at": datetime.datetime.utcnow().isoformat()
        }]).execute()
    except Exception as e:
        log.warning(f"save_alert {ticker}: {e}")

# ── Pushover notification ─────────────────────────────────────────────────────
def push_notify(cfg, title, message, priority=0):
    token = cfg.get("pushover_token")
    user  = cfg.get("pushover_user")
    if not token or not user: return
    try:
        requests.post("https://api.pushover.net/1/messages.json", data={
            "token":    token,
            "user":     user,
            "title":    title,
            "message":  message,
            "priority": priority,
            "sound":    "cashregister" if priority >= 1 else "pushover"
        }, timeout=5)
        log.info(f"Pushover sent: {title}")
    except Exception as e:
        log.warning(f"Pushover failed: {e}")

# ── Main loop ─────────────────────────────────────────────────────────────────
def main():
    log.info("=== Live Monitor starting ===")
    cfg = load_config()
    log.info(f"Tickers: {cfg['tickers']} | Poll: {cfg['poll_interval']}s")

    sb = get_supabase(cfg)
    if sb:
        log.info("Supabase connected")
    else:
        log.warning("Supabase not configured — signals won't be saved")

    # Per-ticker state
    state = {t: {"last_bias": 0, "bars": [], "levels": {}, "levels_fetched": None}
             for t in cfg["tickers"]}

    while True:
        try:
            cfg = load_config()  # reload config each cycle (allows hot updates)

            # Add any new tickers from config
            for t in cfg["tickers"]:
                if t not in state:
                    state[t] = {"last_bias": 0, "bars": [], "levels": {}, "levels_fetched": None}

            if not is_market_open():
                wait = min(seconds_until_open(), 300)
                log.info(f"Market closed — sleeping {int(wait)}s")
                time.sleep(wait)
                continue

            import zoneinfo
            today = datetime.date.today()

            for ticker in cfg["tickers"]:
                s = state[ticker]

                # Refresh S/R levels once per day
                if s["levels_fetched"] != today:
                    s["levels"] = fetch_prev_day_levels(ticker)
                    s["levels_fetched"] = today
                    log.info(f"{ticker} levels: {s['levels'].get('pivots', {})}")

                # Fetch intraday bars
                bars = fetch_intraday(ticker)
                if not bars:
                    log.warning(f"{ticker}: no bars returned")
                    continue
                s["bars"] = bars

                price = bars[-1]["c"]
                bias, reasons, rsi, vwap = compute_bias(bars, s["levels"])

                log.info(f"{ticker} ${price:.2f} bias={bias:+d} RSI={rsi} VWAP={vwap:.2f if vwap else 'N/A'} | {', '.join(reasons) or 'neutral'}")

                # Save signal to Supabase
                save_signal(sb, ticker, bias, price, rsi, vwap, reasons)

                # Check for signal changes
                prev_bias = s["last_bias"]

                # Entry signal
                if bias >= cfg["bias_entry"] and prev_bias < cfg["bias_entry"]:
                    shares = max(1, int(cfg["max_spend"] / price))
                    # Find target and stop
                    levels = s["levels"]
                    piv = levels.get("pivots", {})
                    all_lvls = [(l, p) for l, p in [
                        ("PP", piv.get("PP",0)), ("R1", piv.get("R1",0)),
                        ("S1", piv.get("S1",0)), ("PDH", levels.get("prevDayH",0)),
                        ("PDL", levels.get("prevDayL",0))
                    ] if p and p > 0]
                    above = [(l,p) for l,p in all_lvls if p > price]
                    below = [(l,p) for l,p in all_lvls if p < price]
                    target = min(above, key=lambda x:x[1])[1] if above else None
                    stop   = max(below, key=lambda x:x[1])[1] if below else None

                    reason_str = ", ".join(reasons)
                    save_alert(sb, ticker, "buy", price, bias, reasons, target, stop)

                    title = f"🟢 ENTRY — {ticker}"
                    msg   = (f"Bias +{bias} · {reason_str}\n"
                             f"Entry: ${price:.2f} · {shares} shares\n"
                             + (f"Target: ${target:.2f}  Stop: ${stop:.2f}" if target and stop else ""))
                    log.info(f"ENTRY SIGNAL: {title} | {msg}")
                    push_notify(cfg, title, msg, priority=1)

                # Exit signal
                elif bias <= cfg["bias_exit"] and prev_bias > cfg["bias_exit"]:
                    reason_str = ", ".join(reasons)
                    save_alert(sb, ticker, "sell", price, bias, reasons)

                    title = f"🔴 EXIT — {ticker}"
                    msg   = f"Bias {bias:+d} · {reason_str}\nPrice: ${price:.2f}"
                    log.info(f"EXIT SIGNAL: {title} | {msg}")
                    push_notify(cfg, title, msg, priority=1)

                s["last_bias"] = bias

            time.sleep(cfg["poll_interval"])

        except KeyboardInterrupt:
            log.info("Monitor stopped by user")
            break
        except Exception as e:
            log.error(f"Main loop error: {e}", exc_info=True)
            time.sleep(30)

if __name__ == "__main__":
    main()
